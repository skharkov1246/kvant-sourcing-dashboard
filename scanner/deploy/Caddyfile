# TLS и единственная дверь наружу. Домен подставляется переменной среды
# KVANT_DOMAIN (см. .env.example): для быстрого старта годится
# <ip-сервера>.nip.io — Let's Encrypt такие имена подписывает, отдельный
# домен покупать не обязательно.
{$KVANT_DOMAIN} {
	encode gzip

	# Дашборд контролёра и API ревью — пока dev-инструмент без OIDC (§07.2),
	# поэтому закрыты HTTP-аутентификацией отдельно от API устройств.
	# После аутентификации прокси сам утверждает субъект: заголовки
	# перезаписываются, чтобы клиент не мог назначить себе роль снаружи.
	@review path /review* /v1/review*
	basic_auth @review {
		{$KVANT_REVIEW_USER} {$KVANT_REVIEW_PASSWORD_HASH}
	}
	request_header @review X-Tenant-Id "t-internal"
	request_header @review X-User-Id "reviewer"
	request_header @review X-Roles "reviewer"

	# Кадры и видео идут чанками по мегабайту; лимит держим с запасом,
	# но не бесконечным — иначе один клиент забьёт диск буфера.
	request_body {
		max_size 64MB
	}

	reverse_proxy api:8000

	log {
		output file /data/access.log {
			roll_size 50MB
			roll_keep 5
		}
	}
}
