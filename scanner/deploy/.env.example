# Секреты прод-стенда. Скопировать в .env РЯДОМ с docker-compose.yml и
# заполнить. Файл .env в git не коммитится (см. .gitignore) — он живёт
# только на сервере.

# ── Домен и доступ контролёра ────────────────────────────────────────────
# Для старта годится <ip-сервера>.nip.io — Let's Encrypt такие подписывает.
KVANT_DOMAIN=203.0.113.10.nip.io
KVANT_REVIEW_USER=reviewer
# Хеш пароля: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ваш-пароль'
KVANT_REVIEW_PASSWORD_HASH=$2a$14$...

# ── ИИ-приёмка ───────────────────────────────────────────────────────────
# Без ключа приёмка честно деградирует в ручную проверку — стенд работает,
# но каждая сессия уходит контролёру.
ANTHROPIC_API_KEY=sk-ant-...

# ── Управляемый PostgreSQL (Timeweb / Яндекс / любой) ────────────────────
# sslmode=verify-full — не ослаблять: пароль ходит через интернет.
KVANT_PG_DSN=host=xxxx.twc1.net port=5432 user=gen_user password=... dbname=kvant_scan sslmode=verify-full sslrootcert=/app/certs/root.crt

# ── Объектное хранилище (файлы съёмки, чертежи, облака точек) ────────────
KVANT_S3_ENDPOINT=https://s3.twcstorage.ru
KVANT_S3_REGION=ru-1
KVANT_S3_BUCKET=...
KVANT_S3_ACCESS_KEY=...
KVANT_S3_SECRET_KEY=...

# ── Bitrix (включается профилем bitrix) ──────────────────────────────────
BITRIX_WEBHOOK_URL=https://kvantpro.bitrix24.ru/rest/13/xxxx/
KVANT_PLATFORM_URL=http://api:8000
KVANT_TENANT=t-internal

# ── Денежный контур краудсорсинга ────────────────────────────────────────
# Крипто-рельса выключена: для резидентов РФ выплата в криптовалюте за
# услуги вне правового поля (ФЗ-259). Включать осознанно и по юрисдикции.
KVANT_CRYPTO_RAIL_ENABLED=0
# Чек НПД обязателен только когда подключена интеграция «Мой налог»;
# до неё — 0, иначе выплаты будут падать с честной ошибкой.
KVANT_NPD_RECEIPTS_REQUIRED=0
