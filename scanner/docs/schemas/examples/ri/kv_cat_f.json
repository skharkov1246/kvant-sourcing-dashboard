            "key": "w_mm",
            "type": "number",
            "label": "W",
            "unit": "mm",
            "required": true,
            "min": 1
          },
          {
            "key": "instrument",
            "type": "enum",
            "label": "СИ (номер поверки)",
            "required": true,
            "source": "si_directory"
          }
        ]
      }
    },
