              "край 2"
            ]
          },
          {
            "key": "direction",
            "type": "enum",
            "label": "Направление",
            "required": true,
            "options": [
              "0°",
              "90°"
            ]
          },
          {
            "key": "value_mm",
            "type": "number",
            "label": "Замер",
            "unit": "mm",
            "required": true,
            "min": 0.1
