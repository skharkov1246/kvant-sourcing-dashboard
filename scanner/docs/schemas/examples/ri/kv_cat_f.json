{
  "schema_version": 1,
  "code": "kv_cat_f",
  "version": 1,
  "status": "active",
  "scope": "global",
  "title": "Категория F: зубчатые детали",
  "description": "Р-05 п.5 F, каталог docs/14: оператор снимает счётные и мерные величины — z, da, ширину венца, длину общей нормали W по n_w зубьям; модуль и смещение СЧИТАЕТ СЕРВЕР и показывает у детали — грубая ошибка промера (перепутан обхват, съеден зуб) ловится на месте. Посадка на вал — сеткой, как у тел вращения.",
  "applies_to": {
    "categories": [
      "ri_cat_f"
    ]
  },
  "settings": {
    "estimated_duration_s": 2400
  },
  "steps": [
    {
      "id": "f_safety",
      "kind": "form",
      "title": "Среда и безопасность",
      "form": {
        "fields": [
          {
            "key": "medium",
            "type": "enum",
            "label": "Рабочая среда",
            "required": true,
            "source": "media_directory"
          },
          {
            "key": "ppe_ack",
            "type": "bool",
            "label": "СИЗ надеты",
            "required": true
          }
        ]
      }
    },
    {
      "id": "f_condition",
      "kind": "form",
      "title": "Состояние венца",
      "instruction": "Питтинг и износ рабочих профилей — фиксируйте; выкрошенные зубья пересчитайте и отметьте номера. Полностью разрушенный венец не обмеряется.",
      "form": {
        "fields": [
          {
            "key": "condition",
            "type": "enum",
            "label": "Состояние",
            "required": true,
            "options": [
              "пригодна к обмеру",
              "износ/питтинг, обмер возможен",
              "разрушена — обмер невозможен"
            ]
          },
          {
            "key": "broken_teeth",
            "type": "text",
            "label": "Номера выкрошенных зубьев (если есть)",
            "required": false
          }
        ]
      }
    },
    {
      "id": "f_overview",
      "kind": "photo",
      "title": "Общий вид с обеих сторон",
      "repeat": {
        "min": 2,
        "max": 6
      },
      "quality": {
        "max_blur": 0.35,
        "min_lux": 60,
        "require_subject_fill_pct": [
          25,
          90
        ],
        "on_violation": "warn"
      }
    },
    {
      "id": "f_teeth_macro",
      "kind": "photo",
      "title": "Зубья крупно (профиль и торец)",
      "instruction": "Профиль зуба сбоку и торец венца: по этим кадрам конструктор проверит угол и косозубость.",
      "repeat": {
        "min": 2,
        "max": 6
      },
      "quality": {
        "max_blur": 0.25,
        "min_lux": 80,
        "on_violation": "warn"
      }
    },
    {
      "id": "f_type",
      "kind": "form",
      "title": "Тип передачи",
      "form": {
        "fields": [
          {
            "key": "gear_kind",
            "type": "enum",
            "label": "Тип",
            "required": true,
            "options": [
              "цилиндрическая прямозубая",
              "цилиндрическая косозубая",
              "коническая",
              "червячное колесо",
              "шлицевой венец",
              "прочее"
            ]
          },
          {
            "key": "helix_visible",
            "type": "bool",
            "label": "Наклон зубьев виден на глаз",
