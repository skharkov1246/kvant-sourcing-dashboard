          {
            "key": "b_mm",
            "type": "number",
            "label": "Ширина венца",
            "unit": "mm",
            "required": true,
            "min": 0.5
          },
          {
            "key": "instrument",
            "type": "enum",
            "label": "СИ (номер поверки)",
            "required": true,
            "source": "si_directory"
          }
        ]
      }
    },
    {
      "id": "f_normal",
      "kind": "form",
      "title": "Длина общей нормали",
      "instruction": "Нормалемером или штангенциркулем с тарелками: W по n_w зубьям, номер венца тот же, что в предыдущем шаге. Смещение посчитает сервер.",
      "repeat": {
        "min": 1,
        "max": 4
