{
  "schema_version": 1,
  "code": "kv_desk",
  "version": 1,
  "status": "active",
  "scope": "global",
  "title": "Камеральный протокол конструктора",
  "description": "Каталог docs/14, kv_desk: достройка за столом по материалам полевой сессии. Главный резерв времени всего процесса — снимает 3–6 шагов с полевых сессий C/D/E/F/H: замерщик снимает факты, конструктор назначает номиналы С ОБОСНОВАНИЕМ из справочника (Р-08), подбирает аналоги минимум у двух производителей и решает «литьё или фрезеровка». Неполнота полевых данных — reject_if: сессия возвращается на пересъёмку, а не достраивается догадками.",
  "applies_to": {
    "categories": [
      "ri_desk"
    ]
  },
  "settings": {
    "estimated_duration_s": 1200
  },
  "steps": [
    {
      "id": "dsk_inputs",
      "kind": "form",
      "title": "Входные данные полевой сессии",
      "instruction": "Проверьте полноту: эскиз читается, сетка полна (серверная статистика без ошибок), кадры дефектов на месте. Недостаток данных — честный возврат, а не достройка догадками.",
      "form": {
        "fields": [
          {
            "key": "source_session",
            "type": "text",
            "label": "Код полевой сессии / KV-D",
            "required": true
          },
          {
            "key": "inputs_ok",
            "type": "enum",
            "label": "Полнота данных",
            "required": true,
            "options": [
              "достаточно для РКД",
              "нужна пересъёмка или дозамер"
            ]
          },
          {
            "key": "missing_note",
            "type": "multiline",
            "label": "Чего не хватает (при возврате)",
            "required": false
          }
        ]
      }
    },
    {
      "id": "dsk_nominals",
      "kind": "form",
      "title": "Номиналы с обоснованием (по одному на строку)",
      "instruction": "Р-08 п.3.2–3.3: каждый номинал — с обоснованием из серверной подсказки (направление износа, ряд ГОСТ 6636, дюймовая проверка). Обоснование обязательно: «принял 50» без «почему» в РКД не живёт.",
      "repeat": {
        "min": 1,
        "max": 60
      },
      "form": {
        "fields": [
          {
            "key": "surface_ref",
            "type": "text",
            "label": "Поверхность (№ места по эскизу)",
            "required": true
          },
          {
            "key": "measured_mm",
            "type": "number",
            "label": "База замера",
            "unit": "mm",
            "required": true,
            "min": 0.01
          },
          {
            "key": "nominal_mm",
            "type": "number",
            "label": "Принятый номинал",
            "unit": "mm",
            "required": true,
            "min": 0.01
          },
          {
            "key": "wear_direction",
            "type": "enum",
            "label": "Направление восстановления",
            "required": true,
            "options": [
              "вал изношен — вверх по ряду",
              "отверстие разбито — вниз по ряду",
              "без износа — ближайшее значение",
              "дюймовый размер — не переводить в метрику"
            ]
          },
          {
            "key": "basis",
            "type": "multiline",
            "label": "Обоснование номинала (Р-08 п.3.2)",
            "required": true
          }
        ]
      }
    },
    {
      "id": "dsk_fits",
      "kind": "form",
      "title": "Посадки и допуски",
      "repeat": {
        "min": 1,
        "max": 40
      },
      "form": {
        "fields": [
          {
            "key": "surface_ref",
            "type": "text",
            "label": "Сопряжение (места по эскизу)",
            "required": true
          },
          {
            "key": "fit",
            "type": "text",
            "label": "Посадка/допуск (например H7/k6)",
            "required": true
          },
          {
            "key": "basis",
            "type": "text",
            "label": "Основание (справочник, сопрягаемая деталь)",
            "required": true
          }
        ]
      }
    },
    {
      "id": "dsk_analogs",
      "kind": "form",
      "title": "Аналоги",
      "instruction": "Для покупных — минимум ДВА производителя (Р-05); для уникальных деталей честный ответ «аналогов нет», а не один сомнительный.",
      "form": {
        "fields": [
          {
            "key": "analogs_result",
            "type": "enum",
            "label": "Итог подбора",
            "required": true,
            "options": [
              "подобраны ≥2 производителей",
              "подобран один — риск поставки",
              "аналогов нет — деталь уникальна"
            ]
          },
          {
            "key": "analog1",
            "type": "text",
            "label": "Аналог 1: производитель и артикул",
            "required": false
          },
          {
            "key": "analog2",
            "type": "text",
            "label": "Аналог 2: производитель и артикул",
            "required": false
          }
        ]
      }
    },
    {
      "id": "dsk_blank",
      "kind": "form",
      "title": "Заготовка и технология",
      "form": {
        "fields": [
          {
            "key": "blank_kind",
            "type": "enum",
            "label": "Заготовка",
            "required": true,
            "options": [
              "литьё",
              "поковка/штамповка",
              "прокат — фрезеровка/точение",
              "сварная заготовка",
              "не решено — нужна проработка"
            ]
          },
          {
            "key": "basis",
            "type": "multiline",
            "label": "Обоснование (серийность, материал, следы на образце)",
            "required": true
          }
        ]
      }
    },
    {
      "id": "dsk_confirm",
      "kind": "confirm",
      "title": "Пакет к выпуску",
      "confirm": {
        "text": "Номиналы обоснованы, посадки назначены, аналоги подобраны или честно отсутствуют, заготовка выбрана. Пакет уходит на нормоконтроль."
      }
    }
  ],
  "acceptance": {
    "auto_accept_if": {
      "all": [
        {
          "step": "dsk_nominals"
        },
        {
          "step": "dsk_fits"
        },
        {
          "step": "dsk_analogs"
        },
        {
          "step": "dsk_blank"
        }
      ]
    },
    "reject_if": {
      "step": "dsk_inputs",
      "field": "inputs_ok",
      "eq": "нужна пересъёмка или дозамер"
    }
  }
}
