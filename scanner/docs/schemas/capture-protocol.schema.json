{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvant.ru/scan/schemas/capture-protocol.schema.json",
  "title": "CaptureProtocol",
  "description": "Версионируемый сценарий съёмки, исполняемый мобильным приложением. Документ иммутабелен после публикации.",
  "type": "object",
  "required": ["schema_version", "code", "version", "status", "scope", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Версия формата документа. Клиент отказывается исполнять документ с неизвестной schema_version."
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "description": "Стабильный идентификатор протокола, не меняется между версиями."
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "scope": {
      "type": "string",
      "pattern": "^(global|tenant:[0-9a-fA-F-]{36})$",
      "description": "global или tenant:<uuid>. Тенантный протокол перекрывает глобальный с тем же code."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "description": "Правила автоподбора протокола под задание. Пусто = подбирается только явным указанием.",
      "properties": {
        "categories": { "type": "array", "items": { "type": "string" } },
        "sku_patterns": { "type": "array", "items": { "type": "string", "format": "regex" } },
        "site_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_geo": { "type": "boolean", "default": false },
        "min_battery_pct": { "type": "integer", "minimum": 0, "maximum": 100, "default": 5 },
        "estimated_duration_s": { "type": "integer", "minimum": 1 },
        "allow_pause": { "type": "boolean", "default": true },
        "allow_handoff": {
          "type": "boolean",
          "default": true,
          "description": "Разрешить продолжение сессии на другом устройстве."
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Сколько дней сырьё хранится до архивации. Задаётся политикой тенанта, здесь — переопределение."
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/step" }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_accept_if": { "$ref": "#/$defs/condition" },
        "reject_if": { "$ref": "#/$defs/condition" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ed25519-подпись канонизированного документа без этого поля.",
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string" },
        "value": { "type": "string", "contentEncoding": "base64" }
      }
    }
  },

  "$defs": {
    "on_violation": {
      "enum": ["block", "warn", "ignore"],
      "default": "warn",
      "description": "block — не пускать дальше; warn — предупредить и пустить; ignore — только записать в метаданные."
    },

    "quality": {
      "type": "object",
      "additionalProperties": false,
      "description": "Критерии качества, проверяемые на устройстве до отправки.",
      "properties": {
        "min_resolution_mp": { "type": "number", "minimum": 0.1 },
        "max_blur": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_lux": { "type": "number", "minimum": 0 },
        "glare_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "require_subject_fill_pct": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] доля кадра, занятая объектом."
        },
        "reject_duplicates": { "type": "boolean", "default": true },
        "on_violation": { "$ref": "#/$defs/on_violation" }
      }
    },

    "step": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "additionalProperties": true,
      "description": "Неизвестные поля сохраняются в raw_extras и не ломают исполнение (см. §3.7).",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "kind": { "enum": ["photo", "video", "measure", "code", "form", "weight", "note", "confirm"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "instruction": { "type": "string", "maxLength": 1000 },
        "required": { "type": "boolean", "default": true },
        "hint_overlay": {
          "type": "string",
          "description": "Подсказка-оверлей в видоискателе: frame_4_3, frame_16_9, silhouette:<name>, crosshair."
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "visible_if": { "$ref": "#/$defs/condition" },
        "quality": { "$ref": "#/$defs/quality" },
        "measure": { "$ref": "#/$defs/measureSpec" },
        "code": { "$ref": "#/$defs/codeSpec" },
        "form": { "$ref": "#/$defs/formSpec" },
        "video": { "$ref": "#/$defs/videoSpec" },
        "weight": { "$ref": "#/$defs/weightSpec" },
        "confirm": { "$ref": "#/$defs/confirmSpec" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "measure" } } }, "then": { "required": ["measure"] } },
        { "if": { "properties": { "kind": { "const": "code" } } },    "then": { "required": ["code"] } },
        { "if": { "properties": { "kind": { "const": "form" } } },    "then": { "required": ["form"] } }
      ]
    },

    "measureSpec": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": ["bounding_box", "single_edge", "diameter", "area"],
          "description": "Что измеряем."
        },
        "min_accuracy_class": {
          "enum": ["A", "B", "C", "D"],
          "default": "C",
          "description": "Минимально приемлемый класс точности (см. §05). A — лучший."
        },
        "marker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "size_mm"],
          "properties": {
            "type": { "enum": ["aruco_4x4_50", "aruco_5x5_100", "apriltag_36h11", "credit_card", "a4_sheet"] },
            "size_mm": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "capture_depth": {
          "type": "boolean",
          "default": true,
          "description": "Сохранять карту глубины/облако точек как сырьё для серверного пересчёта."
        },
        "on_violation": { "$ref": "#/$defs/on_violation" }
      }
    },

    "codeSpec": {
      "type": "object",
      "required": ["symbologies"],
      "additionalProperties": false,
      "properties": {
        "symbologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["data_matrix", "qr", "code_128", "gs1_128", "ean_13", "ean_8", "itf_14", "pdf_417", "aztec"]
          }
        },
        "parse": { "enum": ["none", "gs1", "chestny_znak"], "default": "none" },
        "allow_manual": { "type": "boolean", "default": true },
        "expect_prefix": { "type": "string" },
        "quality": { "$ref": "#/$defs/quality" }
      }
    },

    "formSpec": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["key", "type"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
              "type": { "enum": ["text", "number", "bool", "enum", "date", "multiline"] },
              "label": { "type": "string", "maxLength": 120 },
              "required": { "type": "boolean", "default": false },
              "pattern": { "type": "string", "format": "regex" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "unit": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "source": {
                "type": "string",
                "description": "Справочник, синхронизируемый на устройство: iso3166_alpha2, supplier_directory, units."
              },
              "suggest": {
                "type": "string",
                "description": "Источник автодополнения. Работает офлайн из локальной копии справочника."
              },
              "default": {}
            }
          }
        }
      }
    },

    "videoSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_s": { "type": "integer", "minimum": 1, "maximum": 120, "default": 10 },
        "require_motion": {
          "type": "boolean",
          "default": true,
          "description": "Требовать облёт объекта — нужен для серверной фотограмметрии."
        },
        "max_bitrate_kbps": { "type": "integer", "minimum": 500 }
      }
    },

    "weightSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "enum": ["g", "kg"], "default": "kg" },
        "source": { "enum": ["manual", "ble_scale", "any"], "default": "any" },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 }
      }
    },

    "confirmSpec": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "require_signature": { "type": "boolean", "default": false }
      }
    },

    "condition": {
      "description": "Декларативное условие: либо логический оператор (all/any/not), либо предикат по шагу, либо предикат по общему качеству сессии. Без выражений и скриптов — интерпретатор обязан быть тривиально верифицируемым и одинаковым на Android и iOS.",
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        },
        {
          "type": "object",
          "required": ["quality_score_at_least"],
          "additionalProperties": false,
          "properties": { "quality_score_at_least": { "type": "number", "minimum": 0, "maximum": 1 } }
        },
        { "$ref": "#/$defs/stepPredicate" }
      ]
    },

    "stepPredicate": {
      "type": "object",
      "required": ["step"],
      "additionalProperties": false,
      "description": "Предикат по результату ранее выполненного шага. field — путь внутри payload шага (точечная нотация).",
      "properties": {
        "step": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "field": { "type": "string" },
        "eq": {},
        "neq": {},
        "in": { "type": "array" },
        "gt": { "type": "number" },
        "lt": { "type": "number" },
        "exists": { "type": "boolean" },
        "accuracy_class_at_least": { "enum": ["A", "B", "C", "D"] }
      }
    }
  }
}
