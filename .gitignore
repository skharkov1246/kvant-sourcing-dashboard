.venv/
.env
__pycache__/
*.pyc
reports/
.cache/

# дашборд-снимки содержат ПДн — генерируются в CI, в репозиторий не кладём
# (гейт public/_worker.js при этом остаётся в репозитории)
public/*.html
# Статическая оболочка библиотеки не содержит данных; материалы приходят из закрытого API.
!public/library.html
# Оболочка раздела «Поставщики» — тоже без данных: реестр приходит из KV.
!public/suppliers.html
# Оболочка раздела «Номенклатура» — по тому же основанию: котировки приходят из KV.
!public/nomenclature.html
# Оболочка раздела «Счётчики» — тоже без данных: точки замеров приходят из KV.
!public/counters.html
# Оболочка «Бренды и коды» — без данных: сводка, связи и корзины кодов приходят из KV.
!public/brands.html
# Оболочка карточек портала (/p) — без данных: код, бренд, поставщик приходят из базы через воркер.
!public/portal_entity.html

# крупный дамп Bitrix — в репозитории не нужен
agent/corpus.json

.DS_Store

# локальный кэш wrangler
scheduler/.wrangler/
.wrangler/

# база ЗИП: public/ — артефакт сборки (собирается build.py/CI), в репозиторий не кладём
zip/public/
zip/customs/recon/

# локальное состояние тестового контура доступов
access/.contour/
# кэш wrangler содержит account_id и e-mail владельца — в публичном репозитории не нужен
*/.wrangler/

# промежуточные дампы зонда Bitrix (scripts/bitrix_probe.py) — артефакты, не исходники
scripts/_coll_*.json

# каталоги проверок
smoke/
.pytest_cache/
.ruff_cache/

# база фундамента: коммерческие данные, в публичный репозиторий не кладём
base/kvant.db
base/kvant.db-*
base/*.json
